# 6 Signal — server environment variables
# Set these in Netlify (Site settings → Environment variables).
# Every integration degrades gracefully if its key is missing — the funnel
# keeps working, persistence/email just switch off with a logged warning.

# Claude API (audit + strategy + free-check generation) — already configured
ANTHROPIC_API_KEY=

# Supabase project "6signal"
# URL: Supabase Dashboard → Project Settings → API → Project URL
#   (form: https://<your-project-ref>.supabase.co)
# Service role key: Supabase Dashboard → Project Settings → API keys → service_role
# (server-side only; never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email: free-check results, purchase recovery links)
# Verify the 6signal.co domain in Resend, then set both.
RESEND_API_KEY=
EMAIL_FROM="6 Signal <hello@6signal.co>"
# Where owner lead alerts go (one email per free check). Defaults to hello@6signal.co.
LEAD_ALERT_TO=hello@6signal.co

# Meta pixel — enables fbq PageView + funnel events (Lead, InitiateCheckout,
# Purchase) via app/components/MetaPixel.tsx. Public by design. Production value
# is committed in netlify.toml ("Matt Walker's Pixel", personal ad account
# 12117610, used while the 6 Signal ad account is restricted).
NEXT_PUBLIC_META_PIXEL_ID=489336884535822

# Microsoft Clarity (free) — session recordings, click/scroll heatmaps, and
# per-field form engagement on every page. Create a free project at
# clarity.microsoft.com, then set this to its Project ID. Public by design,
# same as the pixel above — safe to commit in netlify.toml once known.
NEXT_PUBLIC_CLARITY_PROJECT_ID=xpq4gifflp

# Instant phone push notifications via ntfy.sh (free). Install the ntfy app,
# subscribe to this topic, set the same value here. The topic name IS the
# secret — use a long random string, never a guessable one. Fires on every
# purchase (urgent for website deposits + Strategy Calls) and every inquiry.
NTFY_TOPIC=

# Internal dashboard (/dashboard) — shared password gate. If unset, the
# dashboard is locked (denies everyone). Set a strong value in Netlify.
DASHBOARD_PASSWORD=
# Looker Studio "Ads" embed URL (Share → Embed report → copy the src URL).
# Leave blank to show a placeholder until the report is built.
NEXT_PUBLIC_LOOKER_URL=

# Shared secret the scheduled tracking function uses to call /api/dashboard/track/cron.
# Set the same value here and it's read by the Netlify scheduled function.
CRON_SECRET=

# Google Ads API — real monthly search volume for evidence-based prompt suggestions.
# OPTIONAL: suggestions still ground on free Google Autocomplete + web "People Also
# Ask" without these. Requires Google Ads API access (developer-token approval can
# take a few days) + an OAuth refresh token. Volume shows once all are set.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # only if calling through a manager (MCC) account
# GOOGLE_ADS_API_VERSION=v18      # override if Google bumps the API version

# Stripe webhook (purchase records + recovery emails)
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL:    https://6signal.co/api/stripe-webhook
#   Events: checkout.session.completed
# Then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=

# Google Places API (New) — authoritative local data for the internal dashboard
# (GBP rating, review count, categories, local competitor landscape). Enable the
# "Places API (New)" in Google Cloud and restrict the key to it. Server-side only.
# Without it, the dashboard's local signals fall back to web-search estimates.
GOOGLE_PLACES_API_KEY=

# Multi-engine AI-visibility probing (continuous tracking). Usage-based keys —
# each powers an authoritative "is the business named in <engine>" check.
# Any that are missing are simply skipped (the run still works with the rest).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (sensible 2026 defaults used if unset):
# OPENAI_MODEL=gpt-5.5
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_ENGINE_MODEL=claude-sonnet-4-6

# SerpAPI — powers the "Google AI Overviews" tracking engine (the actual AI
# Overview block Google shows for each prompt). Free tier: 100 searches/month.
# Sign up at serpapi.com → dashboard → copy your API key. Optional: the other
# engines run without it.
SERPAPI_KEY=
